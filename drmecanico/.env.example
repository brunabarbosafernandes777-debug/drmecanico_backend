# =============================================
# dr Mecânico — Configurações do servidor
# =============================================
# Copie este arquivo para .env e preencha os valores

# Porta do servidor (padrão: 3000)
PORT=3000

# Chave secreta para JWT — gere uma string aleatória longa
# Exemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=coloque_uma_chave_secreta_muito_longa_aqui

# Sua chave da API da Anthropic (começa com sk-ant-)
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Email do super administrador (só este email tem acesso total)
SUPER_ADMIN_EMAIL=brunabarbosafernandes7@gmail.com

# Ambiente (development | production)
NODE_ENV=development
